# Environment Configuration Template
# Copy this file to .env and adjust as needed. All of these are optional -
# the app runs with sensible defaults if .env doesn't exist at all.

# Server
API_HOST=0.0.0.0
API_PORT=8001
DEBUG=false
LOG_LEVEL=INFO

# Security - change this in any real deployment
SECRET_KEY=change_this_super_secret_key_for_production_use_256_bits

# Ollama (LLM)
OLLAMA_HOST=http://localhost:11434
# OLLAMA_EXECUTABLE=C:/path/to/ollama.exe

# Voice pipeline (optional - see deployment/requirements/voice_requirements.txt)
WHISPER_MODEL_SIZE=base
PIPER_VOICE=en_US-hfc_female-medium
PIPER_VOICE_DIR=data/piper_voices
MAX_CONCURRENT_VOICE_REQUESTS=4

# Uploads
MAX_FILE_SIZE=52428800

# RAG tuning
RAG_SIMILARITY_THRESHOLD=0.3
RAG_MAX_RESULTS=5
RAG_MAX_QUERY_LENGTH=500
RAG_MAX_CONVERSATION_TURNS=5
RAG_REQUIRE_SOURCES=false
